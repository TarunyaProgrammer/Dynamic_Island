{
  "name": "beacon",
  "version": "1.1.0",
  "description": "A quiet layer of motivation for macOS — your goals, always in sight.",
  "main": "dist-electron/main/index.js",
  "bin": {
    "beacon": "scripts/beacon-cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build:eventkit && npm run build:preload && vite",
    "build:preload": "esbuild apps/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.cjs",
    "build": "tsc --noEmit && npm run build:preload && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:eventkit": "node scripts/build-eventkit-helper.js",
    "package": "npm run build && npm run build:eventkit && electron-builder",
    "package:dir": "npm run build && npm run build:eventkit && electron-builder --dir",
    "postinstall": "node scripts/ensure-better-sqlite3.js"
  },
  "keywords": [
    "macos",
    "goals",
    "dynamic-island",
    "menu-bar",
    "electron",
    "productivity"
  ],
  "author": "Tarunya K <https://github.com/TarunyaProgrammer>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.beacon.beacon",
    "productName": "Beacon",
    "icon": "assets/Beacon.png",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "TarunyaProgrammer",
      "repo": "Dynamic_Island"
    },
    "afterSign": "scripts/notarize.js",
    "extraResources": [
      {
        "from": "build/BeaconEventKitHelper.app",
        "to": "BeaconEventKitHelper.app"
      },
      "assets/Beacon.png",
      "assets/icon.icns",
      "assets/menubar-icon.png",
      "assets/menubar-icon@2x.png"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Beacon accesses Apple Calendar and Reminders only after you choose to connect them.",
        "NSAccessibilityUsageDescription": "Beacon needs accessibility access to listen for global hotkeys (⌘⇧B) to open the Command Palette from anywhere.",
        "NSUserNotificationsUsageDescription": "Beacon sends subtle alerts when focus sessions and habit streaks are completed.",
        "NSCalendarsFullAccessUsageDescription": "Beacon reads the day’s calendar context only after you ask it to.",
        "NSRemindersFullAccessUsageDescription": "Beacon lists Reminders only when you choose to import one into a goal."
      }
    }
  }
}
